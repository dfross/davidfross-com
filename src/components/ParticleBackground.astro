<div id="particle-bg-container" class="fixed inset-0 -z-10 overflow-hidden pointer-events-none" aria-hidden="true">
	<canvas id="particle-bg-canvas" class="block h-full w-full"></canvas>
</div>

<script>
	import * as THREE from 'three'
	import { OrbitControls } from 'three/addons/controls/OrbitControls.js'
	import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js'
	import { RenderPass } from 'three/addons/postprocessing/RenderPass.js'
	import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js'

	function initParticleBackground() {
		const canvas = document.getElementById('particle-bg-canvas') as HTMLCanvasElement | null
		if (!canvas) return

		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
		if (prefersReducedMotion) return

		// CONFIG - Calmed speed for subtle ambient background
		const COUNT = 20000
		const SPEED_MULT = 0.35
		const AUTO_SPIN = false

		// SETUP
		const scene = new THREE.Scene()
		scene.fog = new THREE.FogExp2(0x000000, 0.01)

		const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 2000)
		camera.position.set(0, 0, 100)

		const renderer = new THREE.WebGLRenderer({
			canvas,
			antialias: true,
			powerPreference: 'high-performance',
			alpha: true,
		})
		renderer.setSize(window.innerWidth, window.innerHeight)
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2))

		const controls = new OrbitControls(camera, renderer.domElement)
		controls.enableDamping = true
		controls.autoRotate = AUTO_SPIN
		controls.autoRotateSpeed = 1.0

		// POST PROCESSING - Dimmed subtle bloom
		const composer = new EffectComposer(renderer)
		composer.addPass(new RenderPass(scene, camera))
		const bloomPass = new UnrealBloomPass(
			new THREE.Vector2(window.innerWidth, window.innerHeight),
			1.5,
			0.4,
			0.85
		)
		bloomPass.strength = 0.25
		bloomPass.radius = 0.3
		bloomPass.threshold = 0.1
		composer.addPass(bloomPass)

		// SWARM OBJECTS
		const dummy = new THREE.Object3D()
		const color = new THREE.Color()
		const target = new THREE.Vector3()

		// INSTANCED MESH - Dimmed low opacity white material
		const geometry = new THREE.TetrahedronGeometry(0.25)
		const material = new THREE.MeshBasicMaterial({
			color: 0xffffff,
			transparent: true,
			opacity: 0.12,
		})

		const instancedMesh = new THREE.InstancedMesh(geometry, material, COUNT)
		instancedMesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage)
		
		// Rotate swarm on X-axis for a dramatic 3D perspective landscape view
		instancedMesh.rotation.x = Math.PI * 0.35
		scene.add(instancedMesh)

		// CONTROL STUBS & INITIAL PARAMS
		const PARAMS: Record<string, number> = {
			scale: 140,
			freq: 1.2,
			amp: 6,
			speed: 0.5,
			wells: 2,
			pull: 6,
			twist: 1.5,
		}
		const addControl = (id: string, _label: string, _min: number, _max: number, val: number) => {
			return PARAMS[id] !== undefined ? PARAMS[id] : val
		}
		const setInfo = (..._args: unknown[]) => {}
		const annotate = (..._args: unknown[]) => {}

		// PRE-COMPUTE INITIAL POSITIONS AT t = 0 SO THE SWARM STARTS FULLY EXPANDED
		const initScale = addControl('scale', 'Fabric Size', 40, 260, 140.0)
		const initFreq = addControl('freq', 'Wave Frequency', 0.5, 6, 1.2)
		const initAmp = addControl('amp', 'Wave Amplitude', 0, 20, 6.0)
		const initWells = addControl('wells', 'Gravity Wells', 0, 4, 2.0)
		const initPull = addControl('pull', 'Well Strength', 0, 20, 6.0)
		const initTwist = addControl('twist', 'Shear Twist', 0, 6, 1.5)

		const t0 = 0
		const w1x0 = Math.sin(t0 * 0.3) * initScale * 0.4
		const w1y0 = Math.cos(t0 * 0.2) * initScale * 0.4
		const w2x0 = Math.sin(t0 * 0.5 + 2.0) * initScale * 0.3
		const w2y0 = Math.cos(t0 * 0.4 + 1.0) * initScale * 0.3

		const positions: THREE.Vector3[] = []
		for (let i = 0; i < COUNT; i++) {
			const u = (Math.sin(i * 12.9898) * 43758.5453) % 1.0
			const v = (Math.sin(i * 78.233) * 12345.6789) % 1.0

			const x = (u * 2.0 - 1.0) * initScale
			const y = (v * 2.0 - 1.0) * initScale

			const wave = Math.sin(x * 0.02 * initFreq + t0) + Math.sin(y * 0.02 * initFreq - t0 * 0.8)
			let z = wave * initAmp

			const dx1 = x - w1x0
			const dy1 = y - w1y0
			const d1 = Math.sqrt(dx1 * dx1 + dy1 * dy1 + 4.0)

			const dx2 = x - w2x0
			const dy2 = y - w2y0
			const d2 = Math.sqrt(dx2 * dx2 + dy2 * dy2 + 4.0)

			const bend1 = -initPull / d1
			const bend2 = -initPull / d2

			z += (bend1 + bend2) * (initWells > 1.0 ? 1.0 : initWells * 0.5)

			const ang = initTwist * (bend1 - bend2)
			const cosA = Math.cos(ang)
			const sinA = Math.sin(ang)

			const tx = x * cosA - y * sinA
			const ty = x * sinA + y * cosA

			const initPos = new THREE.Vector3(tx, ty, z)
			positions.push(initPos)

			dummy.position.copy(initPos)
			dummy.updateMatrix()
			instancedMesh.setMatrixAt(i, dummy.matrix)

			const depth = Math.abs(z) / (initAmp + 0.001)
			const intensity = 0.15 + 0.35 * (1.0 - Math.min(1.0, depth))
			color.setRGB(intensity, intensity, intensity)
			instancedMesh.setColorAt(i, color)
		}

		instancedMesh.instanceMatrix.needsUpdate = true
		if (instancedMesh.instanceColor) {
			instancedMesh.instanceColor.needsUpdate = true
		}

		// ANIMATION LOOP
		const startTime = performance.now()

		function animate() {
			requestAnimationFrame(animate)
			const time = ((performance.now() - startTime) / 1000) * SPEED_MULT

			const matWithUniforms = material as unknown as { uniforms?: Record<string, { value: unknown }> }
			if (matWithUniforms.uniforms && matWithUniforms.uniforms.uTime) {
				matWithUniforms.uniforms.uTime.value = time
			}

			// Gentle slow background drift on Z-axis rotation
			instancedMesh.rotation.z = time * 0.03

			controls.update()

			// SWARM LOGIC
			const scale = addControl('scale', 'Fabric Size', 40, 260, 140.0)
			const freq = addControl('freq', 'Wave Frequency', 0.5, 6, 1.2)
			const amp = addControl('amp', 'Wave Amplitude', 0, 20, 6.0)
			const speed = addControl('speed', 'Flow Speed', 0, 4, 0.5)
			const wells = addControl('wells', 'Gravity Wells', 0, 4, 2.0)
			const pull = addControl('pull', 'Well Strength', 0, 20, 6.0)
			const twist = addControl('twist', 'Shear Twist', 0, 6, 1.5)

			const t = time * speed
			const w1x = Math.sin(t * 0.3) * scale * 0.4
			const w1y = Math.cos(t * 0.2) * scale * 0.4
			const w2x = Math.sin(t * 0.5 + 2.0) * scale * 0.3
			const w2y = Math.cos(t * 0.4 + 1.0) * scale * 0.3

			for (let i = 0; i < COUNT; i++) {
				const u = (Math.sin(i * 12.9898) * 43758.5453) % 1.0
				const v = (Math.sin(i * 78.233) * 12345.6789) % 1.0

				const x = (u * 2.0 - 1.0) * scale
				const y = (v * 2.0 - 1.0) * scale

				const wave = Math.sin(x * 0.02 * freq + t) + Math.sin(y * 0.02 * freq - t * 0.8)
				let z = wave * amp

				const dx1 = x - w1x
				const dy1 = y - w1y
				const d1 = Math.sqrt(dx1 * dx1 + dy1 * dy1 + 4.0)

				const dx2 = x - w2x
				const dy2 = y - w2y
				const d2 = Math.sqrt(dx2 * dx2 + dy2 * dy2 + 4.0)

				const bend1 = -pull / d1
				const bend2 = -pull / d2

				z += (bend1 + bend2) * (wells > 1.0 ? 1.0 : wells * 0.5)

				const ang = twist * (bend1 - bend2)
				const cosA = Math.cos(ang)
				const sinA = Math.sin(ang)

				const tx = x * cosA - y * sinA
				const ty = x * sinA + y * cosA

				target.set(tx, ty, z)

				// Subtle dimmed white grayscale depth variation
				const depth = Math.abs(z) / (amp + 0.001)
				const intensity = 0.15 + 0.35 * (1.0 - Math.min(1.0, depth))
				color.setRGB(intensity, intensity, intensity)

				if (i === 0) {
					setInfo(
						'Space-Time Fabric',
						'A deforming grid of space with moving gravity wells bending the fabric and generating ripples.'
					)
					annotate('well1', new THREE.Vector3(w1x, w1y, -10), 'Gravity Well')
				}

				const pos = positions[i]
				if (pos) {
					pos.lerp(target, 0.1)
					dummy.position.copy(pos)
					dummy.updateMatrix()
					instancedMesh.setMatrixAt(i, dummy.matrix)
					instancedMesh.setColorAt(i, color)
				}
			}

			instancedMesh.instanceMatrix.needsUpdate = true
			if (instancedMesh.instanceColor) {
				instancedMesh.instanceColor.needsUpdate = true
			}

			composer.render()
		}

		animate()

		const handleResize = () => {
			camera.aspect = window.innerWidth / window.innerHeight
			camera.updateProjectionMatrix()
			renderer.setSize(window.innerWidth, window.innerHeight)
			composer.setSize(window.innerWidth, window.innerHeight)
		}

		window.addEventListener('resize', handleResize)
	}

	initParticleBackground()
</script>
