<div id="particle-bg-container" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
	<canvas id="particle-bg-canvas" class="block h-full w-full"></canvas>
</div>

<script>
	import { initParticleBackground } from '../scripts/particle-background'

	// Defer initialization to avoid competing with main thread initial paint
	const win = window as unknown as Window & { requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => void }
	if (typeof win.requestIdleCallback === 'function') {
		win.requestIdleCallback(() => initParticleBackground(), { timeout: 1500 })
	} else {
		window.addEventListener('load', () => initParticleBackground())
	}
</script>
