---
import MainLayout from '../layouts/MainLayout.astro'
---

<MainLayout title="404 - Page Not Found">
	<h1 class="text-display text-cream">
		404 <span class="text-red">&mdash;</span>
		<br /> Page Not Found
	</h1>
	<p class="text-cream -mt-3 text-xl">Sorry, the page you're looking for doesn't exist.</p>
	<a href="/" class="focus-ring text-tan hover:text-blue-light inline-block underline transition-colors">&larr; Return Home</a>
</MainLayout>
