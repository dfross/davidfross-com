---
import MainLayout from '../layouts/MainLayout.astro'
---

<MainLayout title="404 - Page Not Found" description="Sorry, the page you're looking for doesn't exist." noindex>
	<h1 class="text-display text-fg text-balance">
		{'404 '}
		<span class="text-alert">&mdash;</span>
		<br />
		Page Not Found
	</h1>
	<p class="text-fg -mt-3 text-xl text-pretty">Sorry, the page you're looking for doesn't exist.</p>
	<a href="/" class="return-link focus-ring">
		&larr; Return Home
	</a>
</MainLayout>
