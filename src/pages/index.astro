---
import MainLayout from '../layouts/MainLayout.astro'
import { Icon } from 'astro-icon/components'
import { SOCIAL_LINKS } from '../constants'
---

<MainLayout>
	<h1 class="text-fg flex flex-col gap-3 text-2xl text-balance">
		<span>David Fross,</span>
		<span class="text-display">
			{'designer '}
			<span class="text-accent font-normal">&amp;</span>
			{' developer.'}
		</span>
	</h1>
	<p class="text-intro text-fg font-light text-pretty">
		I've spent 20+ years designing and building websites, web apps, and accessible online training. My work covers frontend code, design
		systems, and print. Using AI day to day lets me test more ideas, build faster, and spend more time on the creative side of the work.
	</p>
	<nav aria-label="Social" class="flex flex-wrap gap-6">
		<a
			href={SOCIAL_LINKS.linkedin}
			target="_blank"
			rel="noreferrer"
			class="social-link focus-ring"
			aria-label="Visit David Fross's LinkedIn profile (opens in new tab)">
			<Icon name="linkedin" size="48" aria-hidden="true" />
		</a>
		<a href={`mailto:${SOCIAL_LINKS.email}`} class="social-link focus-ring" aria-label="Send an email to David Fross">
			<Icon name="mailbox" size="48" aria-hidden="true" />
		</a>
	</nav>
</MainLayout>
